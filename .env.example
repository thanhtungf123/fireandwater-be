# Copy to .env and fill in.

# MongoDB connection string (Atlas or local).
MONGODB_URI=

# Port the API listens on.
PORT=4000

# Allowed frontend origins (comma-separated) for CORS.
CORS_ORIGINS=http://localhost:3000

# Secret for signing admin JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Default admin account created by `npm run seed`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Cloudinary (image uploads from the Admin).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
